<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Asa.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="48" Background="Transparent">
            <StackPanel
                Orientation="Horizontal"
                Spacing="9"
                Margin="16,0,0,0"
                VerticalAlignment="Center">
                <Image
                    Source="ms-appx:///Assets/Asa.png"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center" />
                <TextBlock
                    Text="Asa"
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Border
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="6,1"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="winget fácil"
                        FontSize="10"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            Background="Transparent"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            IsPaneOpen="True"
            PaneDisplayMode="Auto"
            CompactModeThresholdWidth="680"
            ExpandedModeThresholdWidth="960"
            OpenPaneLength="224"
            CompactPaneLength="50"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="DiscoverNav" Content="Descobrir" Tag="discover">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="InstalledNav" Content="Instalados" Tag="installed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="UpdatesNav" Content="Atualizações" Tag="updates">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            x:Name="UpdatesBadge"
                            Value="0"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="Atualizações disponíveis" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Grid Margin="12,8,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border
                        Height="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Margin="4,0,4,10" />
                    <Grid Grid.Row="1" ColumnSpacing="8" Margin="6,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            x:Name="WingetStatusDot"
                            Width="7"
                            Height="7"
                            Fill="{ThemeResource SystemFillColorSuccessBrush}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="WingetStatusText"
                            Grid.Column="1"
                            Text="Conectando ao winget…"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="WingetMissingBar"
                    Margin="24,12,24,0"
                    IsOpen="False"
                    IsClosable="True"
                    Severity="Error"
                    Title="O winget não foi encontrado"
                    Message="Instale o App Installer da Microsoft para pesquisar, instalar e atualizar programas.">
                    <InfoBar.ActionButton>
                        <Button Content="Obter o winget" Click="GetWinget_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>

        <Border
            x:Name="ActivityBar"
            Grid.Row="2"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="Collapsed">
            <Grid Padding="16,7" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid VerticalAlignment="Center">
                    <ProgressRing
                        x:Name="ActivityProgress"
                        Width="18"
                        Height="18"
                        IsActive="True" />
                    <FontIcon
                        x:Name="ActivityStatusIcon"
                        Glyph="&#xE73E;"
                        FontSize="15"
                        Visibility="Collapsed"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock
                        x:Name="ActivityTitle"
                        FontSize="12"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="ActivityDetail"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <HyperlinkButton
                    x:Name="ActivityLogButton"
                    Grid.Column="2"
                    Content="Detalhes"
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Click="ActivityLog_Click" />
                <Button
                    x:Name="ActivityCloseButton"
                    Grid.Column="3"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="7"
                    ToolTipService.ToolTip="Fechar"
                    AutomationProperties.Name="Fechar painel de atividade"
                    Click="ActivityClose_Click">
                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
