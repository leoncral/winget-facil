<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== ESTILO DO ITEM DE LISTA (linha 56 px) ====================
         Seleção (SelectionMode=None): o ListView não gerencia seleção, então o
         ListViewItem.IsSelected NÃO é tocado. O fundo vem de PackageRow.IsSelected
         (lido por Content do container): AsaSurfaceActive quando selecionada,
         Transparent quando não — o preenchimento de PointerOver (HoverFill) continua
         visível nas linhas não selecionadas. O VisualState Selected do modelo base
         não é usado. -->
    <Style x:Key="InstalledListItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource PackageListItemStyle}">
        <Setter Property="MinHeight" Value="{StaticResource AsaRowHeight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="RootGrid"
                          Background="{Binding Content.IsSelected, RelativeSource={RelativeSource TemplatedParent},
                                               Converter={StaticResource SelectedBackgroundConverter}}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="HoverFill"
                                            Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0"
                                                                    Value="{ThemeResource AsaSurfaceHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="LeftHairline"
                                            Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- Fundo do hover (sobre a superfície da linha). -->
                        <Border x:Name="HoverFill" Background="Transparent" />

                        <!-- Hairline ciano de 2 px na borda esquerda (apenas hover). -->
                        <Border
                            x:Name="LeftHairline"
                            Width="2"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource AsaActionBrush}"
                            Visibility="Collapsed" />

                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Margin="{TemplateBinding Padding}"
                            AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== LINHA DO PACOTE INSTALADO ====================
         Colunas (especificação seção 6.3 dos tokens):
         checkbox 28 → avatar 40 → nome/ID (*, MinWidth 220) → origem 96 → versão 110 → disponível/ação 120.
         A largura e a visibilidade da coluna ORIGEM vêm de WindowMetrics (oculta abaixo de 1040 px). -->
    <DataTemplate x:Key="InstalledPackageRowTemplate">
        <Border
            BorderBrush="{ThemeResource AsaBorderGhostBrush}"
            BorderThickness="0,0,0,1"
            Padding="0">
            <Grid
                Padding="12,0"
                ColumnSpacing="10"
                Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <!-- Programa (avatar + nome + ID): flexível, mínimo para não colapsar. -->
                    <ColumnDefinition Width="*" MinWidth="220" />
                    <!-- Origem: badge própria, largura fixa (oculta quando a janela está estreita). -->
                    <ColumnDefinition
                        Width="{Binding OriginColumnWidth, Source={StaticResource WindowMetrics}}" />
                    <!-- Versão instalada. -->
                    <ColumnDefinition Width="110" />
                    <!-- Disponível / ação: versão nova ou "Em dia", mais botão de ação (mesma coluna). -->
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <!-- Checkbox: só visível quando há atualização disponível. -->
                <CheckBox
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                    Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibility}}"
                    ToolTipService.ToolTip="Selecionar para atualização"
                    AutomationProperties.Name="Selecionar para atualização" />

                <Grid Grid.Column="1" ColumnSpacing="11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Avatar: 40×40, raio 10, gradiente determinístico pelo id do pacote. -->
                    <Border
                        Grid.Column="0"
                        Width="{StaticResource AsaAvatarSize}"
                        Height="{StaticResource AsaAvatarSize}"
                        CornerRadius="{StaticResource AsaRadiusAvatar}"
                        Background="{Binding Id, Converter={StaticResource AvatarGradientConverter}}"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding Initial}"
                            FontFamily="{StaticResource AsaFontMonoSemiBold}"
                            FontSize="15"
                            FontWeight="SemiBold"
                            CharacterSpacing="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource AsaOnActionBrush}" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock
                            Text="{Binding Name}"
                            Style="{StaticResource AsaBodyMdTextStyle}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding Name}"
                            AutomationProperties.Name="{Binding Name}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding Id}"
                                Style="{StaticResource AsaLabelCodeTextStyle}"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{Binding Id}" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Badge de origem na coluna ORIGEM própria (regra D4). -->
                <Border
                    Grid.Column="2"
                    Padding="6,1"
                    VerticalAlignment="Center"
                    CornerRadius="{StaticResource AsaRadiusSm}"
                    Background="{Binding OriginBadge, Converter={StaticResource OriginBadgeBrushConverter}}"
                    Visibility="{Binding IsOriginColumnVisible, Source={StaticResource WindowMetrics}, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Text="{Binding OriginBadge}"
                        Style="{StaticResource AsaLabelBadgeTextStyle}"
                        Foreground="{ThemeResource AsaTextTertiaryBrush}"
                        VerticalAlignment="Center" />
                </Border>

                <!-- Versão instalada (código, terciária) + indicador de verificação local. -->
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{Binding CurrentVersion}"
                            Style="{StaticResource AsaLabelCodeTextStyle}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            AutomationProperties.Name="{Binding CurrentVersionToolTip}"
                            ToolTipService.ToolTip="{Binding CurrentVersionToolTip}" />
                        <FontIcon
                            Grid.Column="1"
                            Glyph="&#xEA18;"
                            FontSize="11"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource AsaTextTertiaryBrush}"
                            Visibility="{Binding HasDetectedVersion, Converter={StaticResource BoolToVisibility}}"
                            ToolTipService.ToolTip="{Binding CurrentVersionToolTip}"
                            AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                    <TextBlock
                        Text="{Binding CurrentVersionCaption}"
                        Style="{StaticResource AsaLabelCodeTextStyle}"
                        VerticalAlignment="Center" />
                </StackPanel>

                <!--
                    Última coluna (DISPONÍVEL / AÇÃO, 120 px): versão disponível ou "Em dia" à
                    esquerda e botão de ação / indicador da fila à direita. Apenas um estado de
                    ação é exibido por vez — a altura da linha não muda (zero layout shift).
                -->
                <Grid Grid.Column="4" VerticalAlignment="Center" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- Botão/indicador ocupam o espaço que precisam (máximo alvo 40×40). -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Versão disponível / "Em dia" / indisponível (esquerda), apenas quando ocioso. -->
                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowVersionSlot, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Text="{Binding AvailableVersion}"
                            Style="{StaticResource AsaLabelCodeTextStyle}"
                            Foreground="{ThemeResource AsaUpdateBrush}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibility}}"
                            ToolTipService.ToolTip="{Binding AvailableVersion}"
                            AutomationProperties.Name="{Binding AvailableVersion}" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowInSync, Converter={StaticResource BoolToVisibility}}">
                            <FontIcon
                                Glyph="&#xE73E;"
                                FontSize="12"
                                Foreground="{ThemeResource AsaUpdateBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="Em dia"
                                Style="{StaticResource AsaLabelCodeTextStyle}"
                                Foreground="{ThemeResource AsaUpdateBrush}"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="{Binding InSyncMessage}"
                                AutomationProperties.Name="{Binding InSyncMessage}" />
                        </StackPanel>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowUnavailableUpdate, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                Text="{Binding UnavailableUpdateMessage}"
                                Style="{StaticResource AsaLabelCodeTextStyle}"
                                Foreground="{ThemeResource AsaTextTertiaryBrush}"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="{Binding UnavailableUpdateMessage}"
                                AutomationProperties.Name="{Binding UnavailableUpdateMessage}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Botão de ação / indicador da fila (direita), um por vez. -->
                    <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Button
                            Command="{Binding UpdateCommand}"
                            Style="{StaticResource ActionIconButtonStyle}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowActionButton, Converter={StaticResource BoolToVisibility}}"
                            ToolTipService.ToolTip="{Binding ActionToolTip}"
                            AutomationProperties.Name="Atualizar agora">
                            <FontIcon Glyph="&#xE895;" FontSize="14" />
                        </Button>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            Height="32"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowQueueIndicator, Converter={StaticResource BoolToVisibility}}"
                            ToolTipService.ToolTip="{Binding StateText}"
                            AutomationProperties.Name="{Binding RowStatusAutomationName}">
                            <TextBlock
                                Text="{Binding StateText}"
                                Style="{StaticResource AsaBodySmTextStyle}"
                                MaxWidth="96"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            Height="32"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowRunningIndicator, Converter={StaticResource BoolToVisibility}}"
                            ToolTipService.ToolTip="{Binding StateText}"
                            AutomationProperties.Name="{Binding RowStatusAutomationName}">
                            <ProgressRing
                                Width="14"
                                Height="14"
                                IsActive="{Binding ShowRunningIndicator, Mode=OneWay}"
                                Foreground="{ThemeResource AsaActionBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="{Binding StateText}"
                                Style="{StaticResource AsaBodySmTextStyle}"
                                MaxWidth="80"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Height="32"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowSucceededIndicator, Converter={StaticResource BoolToVisibility}}"
                            ToolTipService.ToolTip="{Binding StateText}"
                            AutomationProperties.Name="{Binding RowStatusAutomationName}">
                            <FontIcon
                                Glyph="&#xE73E;"
                                FontSize="14"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource AsaUpdateBrush}" />
                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Height="32"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowFailedIndicator, Converter={StaticResource BoolToVisibility}}"
                            ToolTipService.ToolTip="{Binding StateMessage}"
                            AutomationProperties.Name="{Binding RowStatusAutomationName}">
                            <FontIcon
                                Glyph="&#xE783;"
                                FontSize="14"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource AsaErrorBrush}" />
                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            Height="32"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowCanceledIndicator, Converter={StaticResource BoolToVisibility}}"
                            ToolTipService.ToolTip="{Binding StateText}"
                            AutomationProperties.Name="{Binding RowStatusAutomationName}">
                            <FontIcon
                                Glyph="&#xE711;"
                                FontSize="12"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource AsaTextTertiaryBrush}" />
                            <TextBlock
                                Text="{Binding StateText}"
                                Style="{StaticResource AsaBodySmTextStyle}"
                                MaxWidth="80"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Linha da página Atualizações: repositório dedicado e comparação instalada → nova. -->
    <DataTemplate x:Key="UpdatesPackageRowTemplate">
        <Border BorderBrush="{ThemeResource AsaBorderGhostBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="12,0" ColumnSpacing="10" MinHeight="{StaticResource AsaRowHeight}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="112" />
                </Grid.ColumnDefinitions>

                <CheckBox
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                    Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibility}}"
                    ToolTipService.ToolTip="Selecionar para atualização"
                    AutomationProperties.Name="Selecionar para atualização" />

                <Grid Grid.Column="1" ColumnSpacing="10" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="40"
                        Height="40"
                        CornerRadius="{StaticResource AsaRadiusAvatar}"
                        Background="{Binding Id, Converter={StaticResource AvatarGradientConverter}}"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding Initial}"
                            FontFamily="{StaticResource AsaFontMonoSemiBold}"
                            FontSize="15"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource AsaOnActionBrush}" />
                    </Border>
                    <Grid Grid.Column="1" RowSpacing="2" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{Binding Name}"
                                Style="{StaticResource AsaBodyMdTextStyle}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{Binding Name}"
                                AutomationProperties.Name="{Binding Name}" />
                            <Border
                                Grid.Column="1"
                                Padding="5,1"
                                CornerRadius="{StaticResource AsaRadiusSm}"
                                Background="{ThemeResource AsaCriticalBrush}"
                                Opacity="0.18"
                                Visibility="{Binding IsCritical, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="CRÍTICO"
                                Style="{StaticResource AsaLabelBadgeTextStyle}"
                                Foreground="{ThemeResource AsaCriticalContainerBrush}"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsCritical, Converter={StaticResource BoolToVisibility}}"
                                ToolTipService.ToolTip="{Binding CriticalReason}"
                                AutomationProperties.Name="{Binding CriticalReason}" />
                        </Grid>
                        <TextBlock
                            Grid.Row="1"
                            Text="{Binding Id}"
                            Style="{StaticResource AsaLabelCodeTextStyle}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding Id}" />
                    </Grid>
                </Grid>

                <Border
                    Grid.Column="2"
                    Padding="6,2"
                    VerticalAlignment="Center"
                    CornerRadius="{StaticResource AsaRadiusSm}"
                    Background="{Binding OriginBadge, Converter={StaticResource OriginBadgeBrushConverter}}">
                    <TextBlock
                        Text="{Binding OriginBadge}"
                        Style="{StaticResource AsaLabelBadgeTextStyle}"
                        Foreground="{ThemeResource AsaTextSecondaryBrush}"
                        VerticalAlignment="Center" />
                </Border>

                <Grid Grid.Column="3" ColumnSpacing="8" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{Binding CurrentVersion}"
                        Style="{StaticResource AsaLabelCodeTextStyle}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{Binding CurrentVersionToolTip}"
                        AutomationProperties.Name="{Binding CurrentVersionToolTip}" />
                    <FontIcon
                        Grid.Column="1"
                        Glyph="&#xE72A;"
                        FontSize="12"
                        Foreground="{ThemeResource AsaTextTertiaryBrush}"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock
                        Grid.Column="2"
                        Text="{Binding AvailableVersion}"
                        Style="{StaticResource AsaLabelCodeTextStyle}"
                        Foreground="{ThemeResource AsaUpdateBrush}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{Binding AvailableVersion}"
                        AutomationProperties.Name="{Binding AvailableVersion}" />
                </Grid>

                <Grid Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Button
                        Command="{Binding UpdateCommand}"
                        Style="{StaticResource ActionIconButtonStyle}"
                        Visibility="{Binding ShowActionButton, Converter={StaticResource BoolToVisibility}}"
                        ToolTipService.ToolTip="{Binding ActionToolTip}"
                        AutomationProperties.Name="Atualizar agora">
                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                    </Button>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="5"
                        Height="32"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowQueueIndicator, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="{Binding RowStatusAutomationName}">
                        <TextBlock Text="{Binding StateText}" Style="{StaticResource AsaBodySmTextStyle}" MaxWidth="96" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="5"
                        Height="32"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowRunningIndicator, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="{Binding RowStatusAutomationName}">
                        <ProgressRing Width="14" Height="14" IsActive="{Binding ShowRunningIndicator}" Foreground="{ThemeResource AsaActionBrush}" />
                        <TextBlock Text="{Binding StateText}" Style="{StaticResource AsaBodySmTextStyle}" MaxWidth="84" VerticalAlignment="Center" />
                    </StackPanel>
                    <FontIcon
                        Glyph="&#xE73E;"
                        FontSize="14"
                        Foreground="{ThemeResource AsaUpdateBrush}"
                        Visibility="{Binding ShowSucceededIndicator, Converter={StaticResource BoolToVisibility}}"
                        ToolTipService.ToolTip="{Binding StateText}"
                        AutomationProperties.Name="{Binding RowStatusAutomationName}" />
                    <FontIcon
                        Glyph="&#xE783;"
                        FontSize="14"
                        Foreground="{ThemeResource AsaErrorBrush}"
                        Visibility="{Binding ShowFailedIndicator, Converter={StaticResource BoolToVisibility}}"
                        ToolTipService.ToolTip="{Binding StateMessage}"
                        AutomationProperties.Name="{Binding RowStatusAutomationName}" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="4"
                        Visibility="{Binding ShowCanceledIndicator, Converter={StaticResource BoolToVisibility}}"
                        ToolTipService.ToolTip="{Binding StateText}"
                        AutomationProperties.Name="{Binding RowStatusAutomationName}">
                        <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource AsaTextTertiaryBrush}" />
                        <TextBlock Text="{Binding StateText}" Style="{StaticResource AsaBodySmTextStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
