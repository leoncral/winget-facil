<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="InstalledPackageRowTemplate">
        <Border
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid
                Padding="16,11"
                ColumnSpacing="10"
                Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="120" />
                    <!-- Célula de ação de largura fixa: comporta o botão (32px) e o indicador
                         da fila (glifo/texto), garantindo zero layout shift entre estados. -->
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>

                <CheckBox
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                    Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibility}}"
                    ToolTipService.ToolTip="Selecionar para atualização"
                    AutomationProperties.Name="Selecionar para atualização" />

                <Grid Grid.Column="1" ColumnSpacing="11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="40"
                        Height="40"
                        CornerRadius="11"
                        Background="{ThemeResource AccentFillColorTertiaryBrush}"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding Initial}"
                            FontSize="17"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource PackageNameTextStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{Binding Id}"
                                Style="{StaticResource CaptionTextStyle}"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="{Binding Id}" />
                            <Border Grid.Column="1" Style="{StaticResource SourceBadgeBorderStyle}">
                                <TextBlock
                                    Text="{Binding SourceLabel}"
                                    FontSize="9"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        Text="{Binding CurrentVersion}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{Binding CurrentVersion}" />
                    <TextBlock Text="instalada" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>

                <Grid Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding AvailableVersion}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibility}}"
                        ToolTipService.ToolTip="{Binding AvailableVersion}" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowInSync, Converter={StaticResource BoolToVisibility}}">
                        <FontIcon
                            Glyph="&#xE73E;"
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock
                            Text="Em dia"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!--
                    Coluna de ação: o botão e o indicador da fila são sobrepostos na MESMA
                    célula (largura fixa de 100, altura de 32 centrada) e apenas um fica
                    visível por vez — a altura/posição da linha não muda em nenhum estado.
                    TODO(Fase R / R-3, R-4): aplicar tokens visuais deste indicador
                -->
                <Grid Grid.Column="4" VerticalAlignment="Center">
                    <Button
                        Command="{Binding UpdateCommand}"
                        Style="{StaticResource ActionIconButtonStyle}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowActionButton, Converter={StaticResource BoolToVisibility}}"
                        ToolTipService.ToolTip="{Binding ActionToolTip}"
                        AutomationProperties.Name="Atualizar agora">
                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                    </Button>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="4"
                        Height="32"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowQueueIndicator, Converter={StaticResource BoolToVisibility}}"
                        ToolTipService.ToolTip="{Binding StateText}"
                        AutomationProperties.Name="{Binding RowStatusAutomationName}">
                        <TextBlock
                            Text="{Binding StateText}"
                            Style="{StaticResource CaptionTextStyle}"
                            MaxWidth="96"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="4"
                        Height="32"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowRunningIndicator, Converter={StaticResource BoolToVisibility}}"
                        ToolTipService.ToolTip="{Binding StateText}"
                        AutomationProperties.Name="{Binding RowStatusAutomationName}">
                        <ProgressRing
                            Width="14"
                            Height="14"
                            IsActive="{Binding ShowRunningIndicator, Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="{Binding StateText}"
                            Style="{StaticResource CaptionTextStyle}"
                            MaxWidth="80"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        Height="32"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowSucceededIndicator, Converter={StaticResource BoolToVisibility}}"
                        ToolTipService.ToolTip="{Binding StateText}"
                        AutomationProperties.Name="{Binding RowStatusAutomationName}">
                        <FontIcon
                            Glyph="&#xE73E;"
                            FontSize="14"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    </StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        Height="32"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowFailedIndicator, Converter={StaticResource BoolToVisibility}}"
                        ToolTipService.ToolTip="{Binding StateMessage}"
                        AutomationProperties.Name="{Binding RowStatusAutomationName}">
                        <FontIcon
                            Glyph="&#xE783;"
                            FontSize="14"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource ErrorStatusForegroundBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
