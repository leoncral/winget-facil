<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="InstalledPackageRowTemplate">
        <Border
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid
                Padding="16,11"
                ColumnSpacing="10"
                Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>

                <CheckBox
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                    Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibility}}"
                    ToolTipService.ToolTip="Selecionar para atualização"
                    AutomationProperties.Name="Selecionar para atualização" />

                <Grid Grid.Column="1" ColumnSpacing="11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="40"
                        Height="40"
                        CornerRadius="11"
                        Background="{ThemeResource AccentFillColorTertiaryBrush}"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding Initial}"
                            FontSize="17"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource PackageNameTextStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{Binding Id}"
                                Style="{StaticResource CaptionTextStyle}"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="{Binding Id}" />
                            <Border Grid.Column="1" Style="{StaticResource SourceBadgeBorderStyle}">
                                <TextBlock
                                    Text="{Binding SourceLabel}"
                                    FontSize="9"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        Text="{Binding CurrentVersion}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{Binding CurrentVersion}" />
                    <TextBlock Text="instalada" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>

                <Grid Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding AvailableVersion}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibility}}"
                        ToolTipService.ToolTip="{Binding AvailableVersion}" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowInSync, Converter={StaticResource BoolToVisibility}}">
                        <FontIcon
                            Glyph="&#xE73E;"
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock
                            Text="Em dia"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <Button
                    Grid.Column="4"
                    Command="{Binding UpdateCommand}"
                    Style="{StaticResource ActionIconButtonStyle}"
                    Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibility}}"
                    ToolTipService.ToolTip="{Binding ActionToolTip}"
                    AutomationProperties.Name="Atualizar agora">
                    <FontIcon Glyph="&#xE895;" FontSize="14" />
                </Button>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
