<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== ESTILO DO ITEM DE LISTA (linha 56 px) ====================
         SeleÃ§Ã£o (SelectionMode=None): o ListView nÃ£o gerencia seleÃ§Ã£o, entÃ£o o
         ListViewItem.IsSelected NÃƒO Ã© tocado. O fundo vem de PackageRow.IsSelected
         (lido por Content do container): AsaSurfaceActive quando selecionada,
         Transparent quando nÃ£o â€” o preenchimento de PointerOver (HoverFill) continua
         visÃ­vel nas linhas nÃ£o selecionadas. O VisualState Selected do modelo base
         nÃ£o Ã© usado. -->
    <Style x:Key="InstalledListItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource PackageListItemStyle}">
        <Setter Property="MinHeight" Value="{StaticResource AsaRowHeight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="RootGrid"
                          Background="{Binding Content.IsSelected, RelativeSource={RelativeSource TemplatedParent},
                                               Converter={StaticResource SelectedBackgroundConverter}}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="HoverFill"
                                            Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0"
                                                                    Value="{ThemeResource AsaSurfaceHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="LeftHairline"
                                            Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- Fundo do hover (sobre a superfÃ­cie da linha). -->
                        <Border x:Name="HoverFill" Background="Transparent" />

                        <!-- Hairline ciano de 2 px na borda esquerda (apenas hover). -->
                        <Border
                            x:Name="LeftHairline"
                            Width="2"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource AsaActionBrush}"
                            Visibility="Collapsed" />

                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Margin="{TemplateBinding Padding}"
                            AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== LINHA DO PACOTE INSTALADO ====================
         Colunas (especificaÃ§Ã£o seÃ§Ã£o 6.3 dos tokens):
         checkbox 28 â†’ avatar 40 â†’ nome/ID (*, MinWidth 220) â†’ origem 96 â†’ versÃ£o 110 â†’ disponÃ­vel/aÃ§Ã£o 120.
         A largura e a visibilidade da coluna ORIGEM vÃªm de WindowMetrics (oculta abaixo de 1040 px). -->
    <DataTemplate x:Key="InstalledPackageRowTemplate">
        <Border
            BorderBrush="{ThemeResource AsaBorderGhostBrush}"
            BorderThickness="0,0,0,1"
            Padding="0">
            <Grid
                Padding="12,0"
                ColumnSpacing="10"
                Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <!-- Programa (avatar + nome + ID): flexÃ­vel, mÃ­nimo para nÃ£o colapsar. -->
                    <ColumnDefinition Width="*" MinWidth="220" />
                    <!-- Origem: badge prÃ³pria, largura fixa (oculta quando a janela estÃ¡ estreita). -->
                    <ColumnDefinition
                        Width="{Binding OriginColumnWidth, Source={StaticResource WindowMetrics}}" />
                    <!-- VersÃ£o instalada. -->
                    <ColumnDefinition Width="110" />
                    <!-- DisponÃ­vel / aÃ§Ã£o: versÃ£o nova ou "Em dia", mais botÃ£o de aÃ§Ã£o (mesma coluna). -->
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <!-- Checkbox: sÃ³ visÃ­vel quando hÃ¡ atualizaÃ§Ã£o disponÃ­vel. -->
                <CheckBox
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                    Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibility}}"
                    ToolTipService.ToolTip="Selecionar para atualizaÃ§Ã£o"
                    AutomationProperties.Name="Selecionar para atualizaÃ§Ã£o" />

                <Grid Grid.Column="1" ColumnSpacing="11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Avatar: 40Ã—40, raio 10, gradiente determinÃ­stico pelo id do pacote. -->
                    <Border
                        Grid.Column="0"
                        Width="{StaticResource AsaAvatarSize}"
                        Height="{StaticResource AsaAvatarSize}"
                        CornerRadius="{StaticResource AsaRadiusAvatar}"
                        Background="{Binding Id, Converter={StaticResource AvatarGradientConverter}}"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding Initial}"
                            FontFamily="{StaticResource AsaFontMonoSemiBold}"
                            FontSize="15"
                            FontWeight="SemiBold"
                            CharacterSpacing="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource AsaOnActionBrush}" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <!-- Nome + badge de criticidade (herdado da antiga tela AtualizaÃ§Ãµes):
                             o chip "CrÃ­ticos" precisa que o rÃ³tulo esteja visÃ­vel na linha. -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock
                                Text="{Binding Name}"
                                Style="{StaticResource AsaBodyMdTextStyle}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{Binding Name}"
                                AutomationProperties.Name="{Binding Name}" />
                            <Border
                                Padding="5,1"
                                CornerRadius="{StaticResource AsaRadiusSm}"
                                Background="{ThemeResource AsaCriticalBrush}"
                                Opacity="0.18"
                                Visibility="{Binding IsCritical, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock
                                Text="CRÃTICO"
                                Style="{StaticResource AsaLabelBadgeTextStyle}"
                                Foreground="{ThemeResource AsaCriticalContainerBrush}"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsCritical, Converter={StaticResource BoolToVisibility}}"
                                ToolTipService.ToolTip="{Binding CriticalReason}"
                                AutomationProperties.Name="{Binding CriticalReason}" />
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding Id}"
                                Style="{StaticResource AsaLabelCodeTextStyle}"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{Binding Id}" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Badge de origem na coluna ORIGEM prÃ³pria (regra D4). -->
                <Border
                    Grid.Column="2"
                    Padding="6,1"
                    VerticalAlignment="Center"
                    CornerRadius="{StaticResource AsaRadiusSm}"
                    Background="{Binding OriginBadge, Converter={StaticResource OriginBadgeBrushConverter}}"
                    Visibility="{Binding IsOriginColumnVisible, Source={StaticResource WindowMetrics}, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Text="{Binding OriginBadge}"
                        Style="{StaticResource AsaLabelBadgeTextStyle}"
                        Foreground="{ThemeResource AsaTextTertiaryBrush}"
                        VerticalAlignment="Center" />
                </Border>

                <!-- VersÃ£o instalada (cÃ³digo, terciÃ¡ria) + indicador de verificaÃ§Ã£o local. -->
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{Binding CurrentVersion}"
                            Style="{StaticResource AsaLabelCodeTextStyle}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            AutomationProperties.Name="{Binding CurrentVersionToolTip}"
                            ToolTipService.ToolTip="{Binding CurrentVersionToolTip}" />
                        <FontIcon
                            Grid.Column="1"
                            Glyph="&#xEA18;"
                            FontSize="11"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource AsaTextTertiaryBrush}"
                            Visibility="{Binding HasDetectedVersion, Converter={StaticResource BoolToVisibility}}"
                            ToolTipService.ToolTip="{Binding CurrentVersionToolTip}"
                            AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                    <TextBlock
                        Text="{Binding CurrentVersionCaption}"
                        Style="{StaticResource AsaLabelCodeTextStyle}"
                        VerticalAlignment="Center" />
                </StackPanel>

                <!--
                    Ãšltima coluna (DISPONÃVEL / AÃ‡ÃƒO, 120 px): versÃ£o disponÃ­vel ou "Em dia" Ã 
                    esquerda e botÃ£o de aÃ§Ã£o / indicador da fila Ã  direita. Apenas um estado de
                    aÃ§Ã£o Ã© exibido por vez â€” a altura da linha nÃ£o muda (zero layout shift).
                -->
                <Grid Grid.Column="4" VerticalAlignment="Center" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- BotÃ£o/indicador ocupam o espaÃ§o que precisam (mÃ¡ximo alvo 40Ã—40). -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- VersÃ£o disponÃ­vel / "Em dia" / indisponÃ­vel (esquerda), apenas quando ocioso. -->
                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowVersionSlot, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Text="{Binding AvailableVersion}"
                            Style="{StaticResource AsaLabelCodeTextStyle}"
                            Foreground="{ThemeResource AsaUpdateBrush}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibility}}"
                            ToolTipService.ToolTip="{Binding AvailableVersion}"
                            AutomationProperties.Name="{Binding AvailableVersion}" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowInSync, Converter={StaticResource BoolToVisibility}}">
                            <FontIcon
                                Glyph="&#xE73E;"
                                FontSize="12"
                                Foreground="{ThemeResource AsaUpdateBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="Em dia"
                                Style="{StaticResource AsaLabelCodeTextStyle}"
                                Foreground="{ThemeResource AsaUpdateBrush}"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="{Binding InSyncMessage}"
                                AutomationProperties.Name="{Binding InSyncMessage}" />
                        </StackPanel>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowUnavailableUpdate, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                Text="{Binding UnavailableUpdateMessage}"
                                Style="{StaticResource AsaLabelCodeTextStyle}"
                                Foreground="{ThemeResource AsaTextTertiaryBrush}"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="{Binding UnavailableUpdateMessage}"
                                AutomationProperties.Name="{Binding UnavailableUpdateMessage}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- BotÃ£o de aÃ§Ã£o / indicador da fila (direita), um por vez. -->
                    <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Button
                            Command="{Binding UpdateCommand}"
                            Style="{StaticResource ActionIconButtonStyle}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowActionButton, Converter={StaticResource BoolToVisibility}}"
                            ToolTipService.ToolTip="{Binding ActionToolTip}"
                            AutomationProperties.Name="Atualizar agora">
                            <FontIcon Glyph="&#xE895;" FontSize="14" />
                        </Button>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            Height="32"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowQueueIndicator, Converter={StaticResource BoolToVisibility}}"
                            ToolTipService.ToolTip="{Binding StateText}"
                            AutomationProperties.Name="{Binding RowStatusAutomationName}">
                            <TextBlock
                                Text="{Binding StateText}"
                                Style="{StaticResource AsaBodySmTextStyle}"
                                MaxWidth="96"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            Height="32"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowRunningIndicator, Converter={StaticResource BoolToVisibility}}"
                            ToolTipService.ToolTip="{Binding StateText}"
                            AutomationProperties.Name="{Binding RowStatusAutomationName}">
                            <ProgressRing
                                Width="14"
                                Height="14"
                                IsActive="{Binding ShowRunningIndicator, Mode=OneWay}"
                                Foreground="{ThemeResource AsaActionBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="{Binding StateText}"
                                Style="{StaticResource AsaBodySmTextStyle}"
                                MaxWidth="80"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Height="32"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowSucceededIndicator, Converter={StaticResource BoolToVisibility}}"
                            ToolTipService.ToolTip="{Binding StateText}"
                            AutomationProperties.Name="{Binding RowStatusAutomationName}">
                            <FontIcon
                                Glyph="&#xE73E;"
                                FontSize="14"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource AsaUpdateBrush}" />
                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Height="32"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowFailedIndicator, Converter={StaticResource BoolToVisibility}}"
                            ToolTipService.ToolTip="{Binding StateMessage}"
                            AutomationProperties.Name="{Binding RowStatusAutomationName}">
                            <FontIcon
                                Glyph="&#xE783;"
                                FontSize="14"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource AsaErrorBrush}" />
                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            Height="32"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowCanceledIndicator, Converter={StaticResource BoolToVisibility}}"
                            ToolTipService.ToolTip="{Binding StateText}"
                            AutomationProperties.Name="{Binding RowStatusAutomationName}">
                            <FontIcon
                                Glyph="&#xE711;"
                                FontSize="12"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource AsaTextTertiaryBrush}" />
                            <TextBlock
                                Text="{Binding StateText}"
                                Style="{StaticResource AsaBodySmTextStyle}"
                                MaxWidth="80"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
