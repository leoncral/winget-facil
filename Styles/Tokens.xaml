            <SolidColorBrush x:Key="AsaTextDisabledBrush" Color="#FF808080" />
            <SolidColorBrush x:Key="AsaActionBrush" Color="#FF00FFFF" />
            <SolidColorBrush x:Key="AsaActionHoverBrush" Color="#FF00FFFF" />
            <SolidColorBrush x:Key="AsaActionPressedBrush" Color="#FF00FFFF" />
            <SolidColorBrush x:Key="AsaOnActionBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="AsaUpdateBrush" Color="#FF00FF00" />
            <SolidColorBrush x:Key="AsaUpdateBrightBrush" Color="#FF00FF00" />
            <SolidColorBrush x:Key="AsaOnUpdateBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="AsaCriticalBrush" Color="#FFFFFF00" />
