            <Color x:Key="AsaOnErrorColor">#FF000000</Color>
            <Color x:Key="AsaOnErrorContainerColor">#FFFFFFFF</Color>
            <Color x:Key="AsaFocusRingColor">#FFFFFFFF</Color>
            <SolidColorBrush x:Key="AsaSurfaceCanvasBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="AsaSurfaceBaseBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="AsaSurfaceSunkenBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="AsaSurfaceRailBrush" Color="#FF000000" />
