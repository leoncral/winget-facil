<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== FONTES (Assets/Fonts, licença OFL) ==================== -->
    <FontFamily x:Key="AsaFontSpaceGroteskBold">ms-appx:///Assets/Fonts/SpaceGrotesk-Bold.ttf#Space Grotesk</FontFamily>
    <FontFamily x:Key="AsaFontSpaceGroteskSemiBold">ms-appx:///Assets/Fonts/SpaceGrotesk-SemiBold.ttf#Space Grotesk</FontFamily>
    <FontFamily x:Key="AsaFontJakartaRegular">ms-appx:///Assets/Fonts/PlusJakartaSans-Regular.ttf#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="AsaFontJakartaMedium">ms-appx:///Assets/Fonts/PlusJakartaSans-Medium.ttf#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="AsaFontJakartaSemiBold">ms-appx:///Assets/Fonts/PlusJakartaSans-SemiBold.ttf#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="AsaFontMonoMedium">ms-appx:///Assets/Fonts/JetBrainsMono-Medium.ttf#JetBrains Mono</FontFamily>
    <FontFamily x:Key="AsaFontMonoSemiBold">ms-appx:///Assets/Fonts/JetBrainsMono-SemiBold.ttf#JetBrains Mono</FontFamily>

    <!-- ==================== ESCALA / ESPAÇAMENTO / RAIOS ==================== -->
    <x:Double x:Key="AsaSpaceXs">4</x:Double>
    <x:Double x:Key="AsaSpaceSm">8</x:Double>
    <x:Double x:Key="AsaSpaceMd">12</x:Double>
    <x:Double x:Key="AsaSpaceLg">20</x:Double>
    <x:Double x:Key="AsaSpaceXl">32</x:Double>
    <x:Double x:Key="AsaGutter">16</x:Double>
    <x:Double x:Key="AsaGutterCompact">8</x:Double>

    <Thickness x:Key="AsaMarginPage">28,28,28,28</Thickness>
    <Thickness x:Key="AsaMarginWindow">16,0,16,0</Thickness>

    <CornerRadius x:Key="AsaRadiusSm">4</CornerRadius>
    <CornerRadius x:Key="AsaRadiusDefault">8</CornerRadius>
    <CornerRadius x:Key="AsaRadiusMd">12</CornerRadius>
    <CornerRadius x:Key="AsaRadiusLg">16</CornerRadius>
    <CornerRadius x:Key="AsaRadiusXl">24</CornerRadius>
    <CornerRadius x:Key="AsaRadiusFull">999</CornerRadius>

    <!-- ==================== MÉTRICAS ==================== -->
    <x:Double x:Key="AsaTitleBarHeight">48</x:Double>
    <x:Double x:Key="AsaSidebarWidth">240</x:Double>
    <x:Double x:Key="AsaSidebarWidthCompact">64</x:Double>
    <x:Double x:Key="AsaStatusBarHeight">32</x:Double>
    <x:Double x:Key="AsaActivityBarHeight">56</x:Double>
    <x:Double x:Key="AsaRowHeight">56</x:Double>
    <x:Double x:Key="AsaMinWindowWidth">900</x:Double>
    <x:Double x:Key="AsaMinWindowHeight">600</x:Double>
    <x:Double x:Key="AsaSidebarCollapseThreshold">1040</x:Double>

    <!-- ==================== PALETA (dark-only; HC sobrescreve) ==================== -->
    <Color x:Key="AsaSurfaceCanvasColor">#FF08090D</Color>
    <Color x:Key="AsaSurfaceBaseColor">#FF111318</Color>
    <Color x:Key="AsaSurfaceSunkenColor">#FF0C0E12</Color>
    <Color x:Key="AsaSurfaceRailColor">#FF1A1C20</Color>
    <Color x:Key="AsaSurfaceCardColor">#FF1E2024</Color>
    <Color x:Key="AsaSurfaceHoverColor">#FF282A2E</Color>
    <Color x:Key="AsaSurfaceActiveColor">#FF333539</Color>
    <Color x:Key="AsaOutlineColor">#FF849495</Color>
    <Color x:Key="AsaOutlineVariantColor">#FF3B494B</Color>

    <Color x:Key="AsaTextPrimaryColor">#FFE2E2E8</Color>
    <Color x:Key="AsaTextSecondaryColor">#FFB9CACB</Color>
    <Color x:Key="AsaTextTertiaryColor">#FF94A3B8</Color>
    <Color x:Key="AsaTextDisabledColor">#FF64748B</Color>

    <Color x:Key="AsaActionColor">#FF00F0FF</Color>
    <Color x:Key="AsaActionHoverColor">#FF7DF4FF</Color>
    <Color x:Key="AsaActionPressedColor">#FF00DBE9</Color>
    <Color x:Key="AsaOnActionColor">#FF002022</Color>

    <Color x:Key="AsaUpdateColor">#FF00E575</Color>
    <Color x:Key="AsaUpdateBrightColor">#FF62FF96</Color>
    <Color x:Key="AsaOnUpdateColor">#FF00210B</Color>

    <Color x:Key="AsaCriticalColor">#FFD946EF</Color>
    <Color x:Key="AsaCriticalContainerColor">#FFFFC7FF</Color>
    <Color x:Key="AsaOnCriticalColor">#FF36003E</Color>

    <Color x:Key="AsaErrorColor">#FFFFB4AB</Color>
    <Color x:Key="AsaErrorContainerColor">#FF93000A</Color>
    <Color x:Key="AsaOnErrorColor">#FF690005</Color>
    <Color x:Key="AsaOnErrorContainerColor">#FFFFDAD6</Color>

    <Color x:Key="AsaFocusRingColor">#FF00F0FF</Color>

    <SolidColorBrush x:Key="AsaSurfaceCanvasBrush" Color="{StaticResource AsaSurfaceCanvasColor}" />
    <SolidColorBrush x:Key="AsaSurfaceBaseBrush" Color="{StaticResource AsaSurfaceBaseColor}" />
    <SolidColorBrush x:Key="AsaSurfaceSunkenBrush" Color="{StaticResource AsaSurfaceSunkenColor}" />
    <SolidColorBrush x:Key="AsaSurfaceRailBrush" Color="{StaticResource AsaSurfaceRailColor}" />
    <SolidColorBrush x:Key="AsaSurfaceCardBrush" Color="{StaticResource AsaSurfaceCardColor}" />
    <SolidColorBrush x:Key="AsaSurfaceHoverBrush" Color="{StaticResource AsaSurfaceHoverColor}" />
    <SolidColorBrush x:Key="AsaSurfaceActiveBrush" Color="{StaticResource AsaSurfaceActiveColor}" />
    <SolidColorBrush x:Key="AsaOutlineBrush" Color="{StaticResource AsaOutlineColor}" />
    <SolidColorBrush x:Key="AsaOutlineVariantBrush" Color="{StaticResource AsaOutlineVariantColor}" />

    <SolidColorBrush x:Key="AsaTextPrimaryBrush" Color="{StaticResource AsaTextPrimaryColor}" />
    <SolidColorBrush x:Key="AsaTextSecondaryBrush" Color="{StaticResource AsaTextSecondaryColor}" />
    <SolidColorBrush x:Key="AsaTextTertiaryBrush" Color="{StaticResource AsaTextTertiaryColor}" />
    <SolidColorBrush x:Key="AsaTextDisabledBrush" Color="{StaticResource AsaTextDisabledColor}" />

    <SolidColorBrush x:Key="AsaActionBrush" Color="{StaticResource AsaActionColor}" />
    <SolidColorBrush x:Key="AsaActionHoverBrush" Color="{StaticResource AsaActionHoverColor}" />
    <SolidColorBrush x:Key="AsaActionPressedBrush" Color="{StaticResource AsaActionPressedColor}" />
    <SolidColorBrush x:Key="AsaOnActionBrush" Color="{StaticResource AsaOnActionColor}" />
    <SolidColorBrush x:Key="AsaUpdateBrush" Color="{StaticResource AsaUpdateColor}" />
    <SolidColorBrush x:Key="AsaUpdateBrightBrush" Color="{StaticResource AsaUpdateBrightColor}" />
    <SolidColorBrush x:Key="AsaOnUpdateBrush" Color="{StaticResource AsaOnUpdateColor}" />
    <SolidColorBrush x:Key="AsaCriticalBrush" Color="{StaticResource AsaCriticalColor}" />
    <SolidColorBrush x:Key="AsaCriticalContainerBrush" Color="{StaticResource AsaCriticalContainerColor}" />
    <SolidColorBrush x:Key="AsaErrorBrush" Color="{StaticResource AsaErrorColor}" />
    <SolidColorBrush x:Key="AsaErrorContainerBrush" Color="{StaticResource AsaErrorContainerColor}" />
    <SolidColorBrush x:Key="AsaOnErrorBrush" Color="{StaticResource AsaOnErrorColor}" />
    <SolidColorBrush x:Key="AsaOnErrorContainerBrush" Color="{StaticResource AsaOnErrorContainerColor}" />

    <SolidColorBrush x:Key="AsaBorderGhostBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="AsaBorderControlBrush" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="AsaBorderHoverBrush" Color="#8000F0FF" />
    <SolidColorBrush x:Key="AsaScrimCardBrush" Color="#BF18202C" />

    <x:Double x:Key="AsaGlowOpacity">0.28</x:Double>

    <!-- ==================== TIPOGRAFIA ==================== -->
    <Style x:Key="AsaDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AsaFontSpaceGroteskBold}" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="LineHeight" Value="44" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-30" />
        <Setter Property="Foreground" Value="{ThemeResource AsaTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="AsaHeadlineLgTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AsaFontSpaceGroteskSemiBold}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="Foreground" Value="{ThemeResource AsaTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="AsaHeadlineMdTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AsaFontSpaceGroteskSemiBold}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-10" />
        <Setter Property="Foreground" Value="{ThemeResource AsaTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="AsaBodyLgTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AsaFontJakartaRegular}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="Foreground" Value="{ThemeResource AsaTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="AsaBodyMdTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AsaFontJakartaRegular}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="{ThemeResource AsaTextPrimaryBrush}" />
    </Style>
    <Style x:Key="AsaBodyMdStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AsaBodyMdTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource AsaFontJakartaSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="AsaBodySmTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AsaFontJakartaRegular}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource AsaTextSecondaryBrush}" />
    </Style>
    <Style x:Key="AsaLabelCodeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AsaFontMonoMedium}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource AsaTextTertiaryBrush}" />
    </Style>
    <Style x:Key="AsaLabelBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AsaFontMonoSemiBold}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource AsaTextTertiaryBrush}" />
    </Style>

    <!-- ==================== ALTO CONTRASTE ==================== -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="HighContrast">
