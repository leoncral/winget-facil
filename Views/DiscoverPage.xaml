<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Asa.Views.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Asa.Models"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearch_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="{StaticResource AsaMarginPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== HERO ====================
             Bloom radial (glow por camadas, sinal de ação) + gradiente HeroGradientBrush. -->
        <Border Grid.Row="0"
                Background="{StaticResource HeroGradientBrush}"
                CornerRadius="{StaticResource AsaRadiusXl}"
                Padding="32,12,32,12"
                MinHeight="184">
            <Grid>
                <!-- Brilhos como fundos sobrepostos: não participam da medição do Grid. -->
                <Border IsHitTestVisible="False" Opacity="{ThemeResource AsaGlowOpacity}">
                    <Border.Background>
                        <RadialGradientBrush Center="0.82,0.58" GradientOrigin="0.82,0.58"
                                             RadiusX="0.62" RadiusY="0.9">
                            <GradientStop Color="{ThemeResource AsaActionColor}" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <Border IsHitTestVisible="False" Opacity="{ThemeResource AsaGlowOpacity}">
                    <Border.Background>
                        <RadialGradientBrush Center="0.88,0.52" GradientOrigin="0.88,0.52"
                                             RadiusX="0.36" RadiusY="0.6">
                            <GradientStop Color="{ThemeResource AsaActionColor}" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <Image Source="ms-appx:///Assets/Asa.png"
                       Width="150" Height="150"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,42,0"
                       Opacity="0.16"
                       IsHitTestVisible="False" />

                <StackPanel MaxWidth="720" HorizontalAlignment="Stretch" Spacing="8">
                    <TextBlock Style="{StaticResource AsaDisplayTextStyle}"
                               Text="Seu próximo app, a um clique." />

                    <TextBlock Style="{StaticResource AsaBodyLgTextStyle}"
                               Text="Busque no catálogo do winget, instale e mantenha tudo atualizado sem abrir o terminal."
                               TextWrapping="Wrap" />

                    <!-- Campo de busca (44 px) + botão primário neon ao lado, separado por 10 px. -->
                    <Grid HorizontalAlignment="Stretch" MaxWidth="510" ColumnSpacing="10" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Height="44" MaxWidth="400"
                                CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceSunkenBrush}"
                                BorderBrush="{ThemeResource AsaBorderControlBrush}" BorderThickness="1"
                                Padding="12,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="&#xE721;" FontSize="16"
                                          Foreground="{ThemeResource AsaTextTertiaryBrush}"
                                          VerticalAlignment="Center" />

                                <TextBox x:Name="SearchBox" Grid.Column="1" Height="42" Padding="5,0,0,0"
                                         BorderThickness="0" Background="Transparent"
                                         VerticalAlignment="Stretch"
                                         Foreground="{ThemeResource AsaTextPrimaryBrush}"
                                         VerticalContentAlignment="Center"
                                         Loaded="SearchBox_Loaded"
                                         IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                                         TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
                                <TextBlock x:Name="SearchPlaceholder" Grid.Column="1"
                                           Text="Buscar apps, ferramentas, jogos…"
                                           Style="{StaticResource AsaBodyMdTextStyle}"
                                           Foreground="{ThemeResource AsaTextTertiaryBrush}"
                                           Margin="5,0,0,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <Button x:Name="SearchButton" Grid.Column="1" Content="BUSCAR" Height="44" MinWidth="100"
                                CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaActionBrush}"
                                Foreground="{ThemeResource AsaOnActionBrush}"
                                BorderThickness="0" Padding="22,0,22,0"
                                Click="SearchButton_Click"
                                FontFamily="{StaticResource AsaFontMonoSemiBold}"
                                FontSize="11" FontWeight="SemiBold" CharacterSpacing="40"
                                VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Style="{StaticResource AsaLabelCodeTextStyle}"
                               Foreground="{ThemeResource AsaTextTertiaryBrush}"
                               TextWrapping="Wrap">
                        <Run Text="Enter para buscar · " />
                        <Run Text="Ctrl+F" Foreground="{ThemeResource AsaTextDisabledBrush}" />
                        <Run Text=" para focar na busca" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== CONTEÚDO ROLÁVEL ==================== -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,20,0,28">
            <StackPanel Spacing="24">

                <!-- Estado inicial (antes de qualquer busca): chips, cards e categorias. -->
                <StackPanel Visibility="{x:Bind ViewModel.ShowWelcome, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Spacing="24">

                    <!-- Buscas populares: chips com wrap (sem linha horizontal fixa). -->
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource AsaHeadlineMdTextStyle}" Text="Buscas populares" />
                        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Suggestions, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Content="{x:Bind}" Tag="{x:Bind}"
                                                Style="{StaticResource ChipButtonStyle}"
                                                Click="Suggestion_Click" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- 3 cards de benefício (reutilizam CardBorderStyle). -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="20">
                            <StackPanel Spacing="12">
                                <Border Width="34" Height="34" CornerRadius="{StaticResource AsaRadiusDefault}"
                                        Background="{ThemeResource AsaSurfaceHoverBrush}">
                                    <FontIcon Glyph="&#xE7B8;" FontSize="15" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Foreground="{ThemeResource AsaTextPrimaryBrush}" />
                                </Border>
                                <TextBlock Text="Catálogo completo" Style="{StaticResource AsaBodyMdStrongTextStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Milhares de pacotes do repositório oficial, sem precisar aprender comandos."
                                           Style="{StaticResource AsaBodySmTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="20">
                            <StackPanel Spacing="12">
                                <Border Width="34" Height="34" CornerRadius="{StaticResource AsaRadiusDefault}"
                                        Background="{ThemeResource AsaSurfaceHoverBrush}">
                                    <FontIcon Glyph="&#xE895;" FontSize="15" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Foreground="{ThemeResource AsaTextPrimaryBrush}" />
                                </Border>
                                <TextBlock Text="Tudo em dia" Style="{StaticResource AsaBodyMdStrongTextStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Veja quais programas têm atualização e escolha exatamente o que deseja instalar."
                                           Style="{StaticResource AsaBodySmTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="20">
                            <StackPanel Spacing="12">
                                <Border Width="34" Height="34" CornerRadius="{StaticResource AsaRadiusDefault}"
                                        Background="{ThemeResource AsaSurfaceHoverBrush}">
                                    <FontIcon Glyph="&#xE756;" FontSize="15" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Foreground="{ThemeResource AsaTextPrimaryBrush}" />
                                </Border>
                                <TextBlock Text="Simples, de verdade" Style="{StaticResource AsaBodyMdStrongTextStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Acompanhe cada instalação pelo painel de atividade e consulte o log quando quiser."
                                           Style="{StaticResource AsaBodySmTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Explorar por categoria: cards do catálogo curado (F1-7) + "Ver todas". -->
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource AsaHeadlineMdTextStyle}" Text="Explorar por categoria" />

                        <!-- Categorias com dados: wrap horizontal. -->
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                                      Visibility="{x:Bind ViewModel.HasCategories, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="16" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:CatalogCategory">
                                        <Border Style="{StaticResource CardBorderStyle}" Padding="16" MinWidth="200">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="{x:Bind Name, Mode=OneTime}"
                                                           Style="{StaticResource AsaBodyMdStrongTextStyle}"
                                                           TextWrapping="Wrap" MaxLines="2" />
                                                <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                           Foreground="{ThemeResource AsaTextTertiaryBrush}"
                                                           TextWrapping="Wrap">
                                                    <Run Text="{Binding Ids.Count, Mode=OneTime}" />
                                                    <Run Text=" pacotes" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Vazio contextual quando o catálogo não tem categorias. -->
                        <StackPanel Spacing="12"
                                    Visibility="{x:Bind ViewModel.IsEmptyCategories, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="{StaticResource AsaRadiusFull}"
                                    Background="{ThemeResource AsaSurfaceSunkenBrush}"
                                    HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE7BA;" FontSize="20"
                                          Foreground="{ThemeResource AsaTextTertiaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Style="{StaticResource AsaHeadlineMdTextStyle}"
                                       Text="Catálogo indisponível" TextAlignment="Center" />
                            <TextBlock Style="{StaticResource AsaBodySmTextStyle}"
                                       Text="O catálogo curado não pôde ser carregado. Verifique o arquivo de catálogo e reinicie o app."
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
                        </StackPanel>

                        <Button Content="Ver todas" Style="{StaticResource ChipButtonStyle}"
                                Click="ViewAllCategories_Click" HorizontalAlignment="Left"
                                Visibility="{x:Bind ViewModel.HasCategories, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>

                <!-- Carregando inicial. -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="13"
                    Visibility="{x:Bind ViewModel.ShowLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ProgressRing Width="36" Height="36" IsActive="True" />
                    <TextBlock
                        Text="Consultando o catálogo do winget…"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Resultados da busca. -->
                <Grid
                    Visibility="{x:Bind ViewModel.ShowResults, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="1,0,1,10">
                        <TextBlock
                            Text="{x:Bind ViewModel.ResultsSummary, Mode=OneWay}"
                            Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Text="catálogo winget"
                            Style="{StaticResource CaptionTextStyle}" />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,0,0,24">
                        <ListView
                            ItemsSource="{x:Bind ViewModel.Results}"
                            SelectionMode="None"
                            IsItemClickEnabled="False"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            ItemContainerStyle="{StaticResource PackageListItemStyle}"
                            ScrollViewer.HorizontalScrollMode="Disabled"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SearchPackage">
                                    <Border
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">
                                        <Grid Padding="16,10" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" MinWidth="180" />
                                                <ColumnDefinition Width="118" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Width="42"
                                                Height="42"
                                                CornerRadius="{StaticResource AsaRadiusMd}"
                                                Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{x:Bind Initial}"
                                                    FontSize="18"
                                                    FontWeight="SemiBold"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource PackageNameTextStyle}" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Text="{x:Bind Id}"
                                                        Style="{StaticResource CaptionTextStyle}"
                                                        ToolTipService.ToolTip="{x:Bind Id}" />
                                                    <Border Grid.Column="1" Style="{StaticResource SourceBadgeBorderStyle}">
                                                        <TextBlock
                                                            Text="{x:Bind Source}"
                                                            FontSize="9"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock
                                                    Text="{x:Bind VersionDisplay}"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="versão" Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>

                                            <Button
                                                Grid.Column="3"
                                                Content="{x:Bind ActionText, Mode=OneWay}"
                                                IsEnabled="{x:Bind CanInstall, Mode=OneWay}"
                                                Style="{StaticResource PrimaryActionButtonStyle}"
                                                MinWidth="92"
                                                Click="Install_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>

                <!-- Nenhum resultado. -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="420"
                    Spacing="11"
                    Visibility="{x:Bind ViewModel.ShowNoResults, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Border
                        Width="56"
                        Height="56"
                        CornerRadius="{StaticResource AsaRadiusFull}"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        HorizontalAlignment="Center">
                        <FontIcon
                            Glyph="&#xE721;"
                            FontSize="23"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <TextBlock
                        Text="Nenhum app encontrado"
                        Style="{StaticResource SectionTitleTextStyle}"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="Tente outro nome ou use um termo mais curto. O catálogo do winget também pode estar temporariamente indisponível."
                        Style="{StaticResource PageSubtitleTextStyle}"
                        TextAlignment="Center" />
                    <Button
                        Content="Nova busca"
                        HorizontalAlignment="Center"
                        Style="{StaticResource ChipButtonStyle}"
                        Click="FocusSearch_Click" />
                </StackPanel>

                <!-- Erro. -->
                <Border
                    MaxWidth="560"
                    Padding="24"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0"
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="10">
                        <FontIcon
                            Glyph="&#xE7BA;"
                            FontSize="24"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            HorizontalAlignment="Left" />
                        <TextBlock Text="A busca não funcionou" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                            Style="{StaticResource PageSubtitleTextStyle}" />
                        <Button
                            Content="Tentar novamente"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            HorizontalAlignment="Left"
                            Click="RetrySearch_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
