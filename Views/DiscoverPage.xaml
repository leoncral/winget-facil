<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Asa.Views.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Asa.Models"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearch_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="32,22,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            CornerRadius="18"
            Padding="28,24"
            MinHeight="192">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0B7A75" Offset="0" />
                    <GradientStop Color="#0A6698" Offset="0.5" />
                    <GradientStop Color="#164C86" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Ellipse
                    Width="300"
                    Height="300"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,-40,-90,0"
                    Fill="#16FFFFFF"
                    IsHitTestVisible="False" />
                <Ellipse
                    Width="190"
                    Height="190"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,30,25,0"
                    Fill="#0FFFFFFF"
                    IsHitTestVisible="False" />
                <Image
                    Source="ms-appx:///Assets/Asa.png"
                    Width="150"
                    Height="150"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,38,0"
                    Opacity="0.16"
                    IsHitTestVisible="False" />

                <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock
                        FontFamily="Segoe UI Variable Display"
                        FontSize="31"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Seu próximo app, a um clique."
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,7,0,0"
                        FontSize="14"
                        Foreground="#D9FFFFFF"
                        Text="Busque no catálogo do winget, instale e mantenha tudo atualizado sem abrir o terminal."
                        TextWrapping="Wrap" />

                    <Border
                        Margin="0,19,0,0"
                        MaxWidth="680"
                        Height="50"
                        CornerRadius="10"
                        Background="#F5FFFFFF"
                        Padding="13,0,5,0"
                        HorizontalAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Glyph="&#xE721;"
                                FontSize="16"
                                Foreground="#52606D"
                                VerticalAlignment="Center" />

                            <TextBox
                                x:Name="SearchBox"
                                Grid.Column="1"
                                Height="44"
                                Margin="8,0,8,0"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"
                                FontSize="15"
                                Foreground="#1B1B1B"
                                PlaceholderText="Buscar apps, ferramentas, jogos…"
                                PlaceholderForeground="#727B84"
                                IsSpellCheckEnabled="False"
                                IsTextPredictionEnabled="False"
                                TextChanged="SearchBox_TextChanged"
                                KeyDown="SearchBox_KeyDown">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlForeground" Color="#1B1B1B" />
                                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#1B1B1B" />
                                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#1B1B1B" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#727B84" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#727B84" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#727B84" />
                                </TextBox.Resources>
                            </TextBox>

                            <Button
                                x:Name="SearchButton"
                                Grid.Column="2"
                                Content="Buscar"
                                Height="38"
                                MinWidth="84"
                                VerticalAlignment="Center"
                                CornerRadius="8"
                                Background="#0F5FA6"
                                Foreground="White"
                                BorderThickness="0"
                                Click="SearchButton_Click" />
                        </Grid>
                    </Border>

                    <TextBlock
                        Margin="4,9,0,0"
                        FontSize="11"
                        Foreground="#AFFFFFFF"
                        Text="Enter para buscar · Ctrl+F para focar na busca" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <ScrollViewer
                Visibility="{x:Bind ViewModel.ShowWelcome, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollMode="Disabled"
                Padding="0,0,0,24">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="9">
                        <TextBlock Text="Buscas populares" Style="{StaticResource SectionTitleTextStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Suggestions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Content="{Binding}"
                                        Tag="{Binding}"
                                        Style="{StaticResource ChipButtonStyle}"
                                        Click="Suggestion_Click" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16">
                            <StackPanel Spacing="9">
                                <Border
                                    Width="34"
                                    Height="34"
                                    CornerRadius="9"
                                    Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                    <FontIcon
                                        Glyph="&#xE7B8;"
                                        FontSize="15"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Text="Catálogo completo" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Milhares de pacotes do repositório oficial, sem precisar aprender comandos."
                                    Style="{StaticResource CaptionTextStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16">
                            <StackPanel Spacing="9">
                                <Border
                                    Width="34"
                                    Height="34"
                                    CornerRadius="9"
                                    Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                    <FontIcon
                                        Glyph="&#xE895;"
                                        FontSize="15"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Text="Tudo em dia" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Veja quais programas têm atualização e escolha exatamente o que deseja instalar."
                                    Style="{StaticResource CaptionTextStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                            <StackPanel Spacing="9">
                                <Border
                                    Width="34"
                                    Height="34"
                                    CornerRadius="9"
                                    Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                    <FontIcon
                                        Glyph="&#xE756;"
                                        FontSize="15"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Text="Simples, de verdade" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Acompanhe cada instalação pelo painel de atividade e consulte o log quando quiser."
                                    Style="{StaticResource CaptionTextStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="13"
                Visibility="{x:Bind ViewModel.ShowLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <ProgressRing Width="36" Height="36" IsActive="True" />
                <TextBlock
                    Text="Consultando o catálogo do winget…"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid
                Visibility="{x:Bind ViewModel.ShowResults, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="1,0,1,10">
                    <TextBlock
                        Text="{x:Bind ViewModel.ResultsSummary, Mode=OneWay}"
                        Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Text="catálogo winget"
                        Style="{StaticResource CaptionTextStyle}" />
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,0,0,24">
                    <ListView
                        ItemsSource="{x:Bind ViewModel.Results}"
                        SelectionMode="None"
                        IsItemClickEnabled="False"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        ItemContainerStyle="{StaticResource PackageListItemStyle}"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchPackage">
                                <Border
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                    <Grid Padding="16,10" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="180" />
                                            <ColumnDefinition Width="118" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="42"
                                            Height="42"
                                            CornerRadius="11"
                                            Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind Initial}"
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource PackageNameTextStyle}" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Text="{x:Bind Id}"
                                                    Style="{StaticResource CaptionTextStyle}"
                                                    ToolTipService.ToolTip="{x:Bind Id}" />
                                                <Border Grid.Column="1" Style="{StaticResource SourceBadgeBorderStyle}">
                                                    <TextBlock
                                                        Text="{x:Bind Source}"
                                                        FontSize="9"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock
                                                Text="{x:Bind VersionDisplay}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="versão" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>

                                        <Button
                                            Grid.Column="3"
                                            Content="{x:Bind ActionText, Mode=OneWay}"
                                            IsEnabled="{x:Bind CanInstall, Mode=OneWay}"
                                            Style="{StaticResource PrimaryActionButtonStyle}"
                                            MinWidth="92"
                                            Click="Install_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="420"
                Spacing="11"
                Visibility="{x:Bind ViewModel.ShowNoResults, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Border
                    Width="56"
                    Height="56"
                    CornerRadius="28"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    HorizontalAlignment="Center">
                    <FontIcon
                        Glyph="&#xE721;"
                        FontSize="23"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <TextBlock
                    Text="Nenhum app encontrado"
                    Style="{StaticResource SectionTitleTextStyle}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="Tente outro nome ou use um termo mais curto. O catálogo do winget também pode estar temporariamente indisponível."
                    Style="{StaticResource PageSubtitleTextStyle}"
                    TextAlignment="Center" />
                <Button
                    Content="Nova busca"
                    HorizontalAlignment="Center"
                    Style="{StaticResource ChipButtonStyle}"
                    Click="FocusSearch_Click" />
            </StackPanel>

            <Border
                MaxWidth="560"
                Padding="24"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,10,0,0"
                Style="{StaticResource CardBorderStyle}"
                Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="10">
                    <FontIcon
                        Glyph="&#xE7BA;"
                        FontSize="24"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        HorizontalAlignment="Left" />
                    <TextBlock Text="A busca não funcionou" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Style="{StaticResource PageSubtitleTextStyle}" />
                    <Button
                        Content="Tentar novamente"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        HorizontalAlignment="Left"
                        Click="RetrySearch_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
