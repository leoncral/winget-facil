<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Asa.Views.InstalledPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="Refresh_Invoked" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusFilter_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="{StaticResource AsaMarginPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="5">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Seus programas" Style="{StaticResource AsaHeadlineLgTextStyle}" />
                    <!-- Badge herdado da antiga tela Atualizações: só no filtro Atualizações. -->
                    <Border
                        Padding="9,4"
                        CornerRadius="{StaticResource AsaRadiusSm}"
                        Background="{ThemeResource AsaUpdateBrush}"
                        Visibility="{x:Bind ViewModel.UpdatesBadgeVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Text="LOTE DISPONÍVEL"
                            Style="{StaticResource AsaLabelBadgeTextStyle}"
                            Foreground="{ThemeResource AsaOnUpdateBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock
                    Text="{x:Bind ViewModel.HeaderSummary, Mode=OneWay}"
                    Style="{StaticResource AsaBodyLgTextStyle}" />
            </StackPanel>

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Spacing="6">
                <ProgressRing
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Foreground="{ThemeResource AsaActionBrush}"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0" />
                <Button
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Atualizar lista"
                    AutomationProperties.Name="Atualizar lista"
                    Click="Refresh_Click">
                    <FontIcon Glyph="&#xE72C;" FontSize="15" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                x:Name="FilterBox"
                Width="276"
                VerticalAlignment="Center"
                PlaceholderText="Filtrar por nome ou ID"
                TextChanged="FilterBox_TextChanged">
                <AutoSuggestBox.QueryIcon>
                    <FontIcon Glyph="&#xE721;" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>

            <SelectorBar
                x:Name="FilterBar"
                Grid.Column="1"
                VerticalAlignment="Center"
                SelectionChanged="FilterBar_SelectionChanged">
                <SelectorBarItem x:Name="AllFilter" Text="Todos" />
                <SelectorBarItem x:Name="UpdatesFilter" Text="Atualizações" />
            </SelectorBar>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- TODO(Fase R / R-4): padrão visual do "Limpar seleção" (chip vs. botão). -->
                <Button
                    Content="Limpar seleção"
                    Style="{StaticResource ChipButtonStyle}"
                    Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Click="ClearSelection_Click" />
                <Button
                    IsEnabled="{x:Bind ViewModel.CanUpdateSelected, Mode=OneWay}"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.SelectionButtonToolTip, Mode=OneWay}"
                    AutomationProperties.Name="Atualizar selecionados"
                    AutomationProperties.HelpText="{x:Bind ViewModel.SelectionButtonToolTip, Mode=OneWay}"
                    Click="UpdateSelected_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                        <TextBlock Text="{x:Bind ViewModel.SelectionButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Sub-filtros da antiga tela Atualizações, agora só no filtro "Atualizações":
             crítico/origem os chips + total estimado de download. Collapsed fora dele,
             para o Auto não deixar linha vazia. -->
        <StackPanel
            Grid.Row="2"
            Margin="0,2,0,10"
            Spacing="8"
            Visibility="{x:Bind ViewModel.ShowOnlyUpdates, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ToggleButton
                    Content="{x:Bind ViewModel.AllFilterLabel, Mode=OneWay}"
                    IsChecked="{x:Bind ViewModel.IsAllUpdatesFilter, Mode=OneWay}"
                    Style="{StaticResource UpdatesFilterToggleButtonStyle}"
                    Click="AllFilter_Click" />
                <ToggleButton
                    Content="{x:Bind ViewModel.CriticalFilterLabel, Mode=OneWay}"
                    IsChecked="{x:Bind ViewModel.IsCriticalUpdatesFilter, Mode=OneWay}"
                    Style="{StaticResource UpdatesFilterToggleButtonStyle}"
                    Click="CriticalFilter_Click" />
                <ToggleButton
                    Content="{x:Bind ViewModel.WingetFilterLabel, Mode=OneWay}"
                    IsChecked="{x:Bind ViewModel.IsWingetUpdatesFilter, Mode=OneWay}"
                    Style="{StaticResource UpdatesFilterToggleButtonStyle}"
                    Click="WingetFilter_Click" />
                <ToggleButton
                    Content="{x:Bind ViewModel.MsStoreFilterLabel, Mode=OneWay}"
                    IsChecked="{x:Bind ViewModel.IsMsStoreUpdatesFilter, Mode=OneWay}"
                    Style="{StaticResource UpdatesFilterToggleButtonStyle}"
                    Click="MsStoreFilter_Click" />
            </StackPanel>
            <Border
                HorizontalAlignment="Left"
                Padding="12,8"
                CornerRadius="{StaticResource AsaRadiusMd}"
                Background="{ThemeResource AsaSurfaceCardBrush}"
                BorderBrush="{ThemeResource AsaBorderGhostBrush}"
                BorderThickness="1">
                <StackPanel Spacing="2">
                    <TextBlock
                        Text="TOTAL ESTIMADO"
                        Style="{StaticResource AsaLabelBadgeTextStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.TotalEstimatedDownloadDisplay, Mode=OneWay}"
                        Style="{StaticResource AsaBodySmTextStyle}"
                        Foreground="{ThemeResource AsaUpdateBrush}"
                        AutomationProperties.Name="Tamanho total estimado dos downloads" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="8" Margin="0,0,0,10">
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                IsClosable="False"
                Severity="Error"
                Title="Não foi possível atualizar a lista"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Tentar novamente" Click="Retry_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Explica quando uma seleção foi ajustada por Id repetido ou por o pacote já
                 estar na fila: o winget atualiza por Id, não por versão instalada. -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasSelectionNotice, Mode=OneWay}"
                IsClosable="True"
                Severity="Informational"
                Title="Ajuste no lote"
                Message="{x:Bind ViewModel.SelectionNotice, Mode=OneWay}"
                CloseButtonClick="SelectionNotice_Close" />
        </StackPanel>

        <Grid Grid.Row="4">
            <Border
                Style="{StaticResource CardBorderStyle}"
                Padding="0"
                Margin="0,0,0,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        BorderBrush="{ThemeResource AsaBorderGhostBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,7"
                        Visibility="{x:Bind ViewModel.ShowColumnHeader, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" MinWidth="220" />
                                <!-- Origem: ocultada quando a janela está abaixo de 1040 px. -->
                                <ColumnDefinition
                                    Width="{Binding OriginColumnWidth, Source={StaticResource WindowMetrics}}" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <!-- Select-all tri-state: IsChecked bool? sobre a lista FILTRADA
                                 (true = tudo marcado, null = parcial/indeterminado). -->
                            <CheckBox
                                x:Name="SelectAllBox"
                                Grid.Column="0"
                                IsChecked="{x:Bind ViewModel.SelectAllState, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.HasVisibleUpdates, Mode=OneWay}"
                                Click="SelectAll_Click"
                                ToolTipService.ToolTip="Selecionar todas as atualizações"
                                AutomationProperties.Name="Selecionar todas as atualizações" />

                            <TextBlock
                                Grid.Column="1"
                                Text="PROGRAMA"
                                Style="{StaticResource AsaLabelCodeTextStyle}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AsaTextTertiaryBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="2"
                                Text="ORIGEM"
                                Style="{StaticResource AsaLabelCodeTextStyle}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AsaTextTertiaryBrush}"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsOriginColumnVisible, Source={StaticResource WindowMetrics}, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock
                                Grid.Column="3"
                                Text="VERSÃO"
                                Style="{StaticResource AsaLabelCodeTextStyle}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AsaTextTertiaryBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="4"
                                Text="DISPONÍVEL"
                                Style="{StaticResource AsaLabelCodeTextStyle}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AsaTextTertiaryBrush}"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Items}"
                        ItemTemplate="{StaticResource InstalledPackageRowTemplate}"
                        ItemContainerStyle="{StaticResource InstalledListItemStyle}"
                        SelectionMode="None"
                        IsItemClickEnabled="False"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Grid>
            </Border>

            <!-- Skeleton da carga inicial: 6 linhas de 56 px, blocos com raio 8 e superfície
                 de hover em opacidade, sem animação quando AnimationsEnabled == false. -->
            <StackPanel
                VerticalAlignment="Top"
                Margin="0,0,0,24"
                Visibility="{x:Bind ViewModel.ShowSkeleton, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Border Height="56" Padding="12,0">
                    <Grid ColumnSpacing="10" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" MinWidth="220" />
                            <ColumnDefinition Width="{Binding OriginColumnWidth, Source={StaticResource WindowMetrics}}" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <Border Width="18" Height="18" CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6"
                                VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="40" Height="40"
                                CornerRadius="{StaticResource AsaRadiusAvatar}" Background="{ThemeResource AsaSurfaceHoverBrush}"
                                Opacity="0.6" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Height="24" CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6" VerticalAlignment="Center"
                                Margin="8,0,0,0" />
                        <Border Grid.Column="2" Height="22" CornerRadius="{StaticResource AsaRadiusSm}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6" VerticalAlignment="Center"
                                Visibility="{Binding IsOriginColumnVisible, Source={StaticResource WindowMetrics}, Converter={StaticResource BoolToVisibility}}" />
                        <Border Grid.Column="3" Height="14" CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6" VerticalAlignment="Center" />
                        <Border Grid.Column="4" Height="14" CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Height="56" Padding="12,0">
                    <Grid ColumnSpacing="10" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" MinWidth="220" />
                            <ColumnDefinition Width="{Binding OriginColumnWidth, Source={StaticResource WindowMetrics}}" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <Border Width="18" Height="18" CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6"
                                VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="40" Height="40"
                                CornerRadius="{StaticResource AsaRadiusAvatar}" Background="{ThemeResource AsaSurfaceHoverBrush}"
                                Opacity="0.6" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Height="24" CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6" VerticalAlignment="Center"
                                Margin="8,0,0,0" />
                        <Border Grid.Column="2" Height="22" CornerRadius="{StaticResource AsaRadiusSm}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6" VerticalAlignment="Center"
                                Visibility="{Binding IsOriginColumnVisible, Source={StaticResource WindowMetrics}, Converter={StaticResource BoolToVisibility}}" />
                        <Border Grid.Column="3" Height="14" CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6" VerticalAlignment="Center" />
                        <Border Grid.Column="4" Height="14" CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Height="56" Padding="12,0">
                    <Grid ColumnSpacing="10" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" MinWidth="220" />
                            <ColumnDefinition Width="{Binding OriginColumnWidth, Source={StaticResource WindowMetrics}}" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <Border Width="18" Height="18" CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6"
                                VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="40" Height="40"
                                CornerRadius="{StaticResource AsaRadiusAvatar}" Background="{ThemeResource AsaSurfaceHoverBrush}"
                                Opacity="0.6" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Height="24" CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6" VerticalAlignment="Center"
                                Margin="8,0,0,0" />
                        <Border Grid.Column="2" Height="22" CornerRadius="{StaticResource AsaRadiusSm}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6" VerticalAlignment="Center"
                                Visibility="{Binding IsOriginColumnVisible, Source={StaticResource WindowMetrics}, Converter={StaticResource BoolToVisibility}}" />
                        <Border Grid.Column="3" Height="14" CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6" VerticalAlignment="Center" />
                        <Border Grid.Column="4" Height="14" CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Height="56" Padding="12,0">
                    <Grid ColumnSpacing="10" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" MinWidth="220" />
                            <ColumnDefinition Width="{Binding OriginColumnWidth, Source={StaticResource WindowMetrics}}" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <Border Width="18" Height="18" CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6"
                                VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="40" Height="40"
                                CornerRadius="{StaticResource AsaRadiusAvatar}" Background="{ThemeResource AsaSurfaceHoverBrush}"
                                Opacity="0.6" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Height="24" CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6" VerticalAlignment="Center"
                                Margin="8,0,0,0" />
                        <Border Grid.Column="2" Height="22" CornerRadius="{StaticResource AsaRadiusSm}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6" VerticalAlignment="Center"
                                Visibility="{Binding IsOriginColumnVisible, Source={StaticResource WindowMetrics}, Converter={StaticResource BoolToVisibility}}" />
                        <Border Grid.Column="3" Height="14" CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6" VerticalAlignment="Center" />
                        <Border Grid.Column="4" Height="14" CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Height="56" Padding="12,0">
                    <Grid ColumnSpacing="10" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" MinWidth="220" />
                            <ColumnDefinition Width="{Binding OriginColumnWidth, Source={StaticResource WindowMetrics}}" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <Border Width="18" Height="18" CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6"
                                VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="40" Height="40"
                                CornerRadius="{StaticResource AsaRadiusAvatar}" Background="{ThemeResource AsaSurfaceHoverBrush}"
                                Opacity="0.6" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Height="24" CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6" VerticalAlignment="Center"
                                Margin="8,0,0,0" />
                        <Border Grid.Column="2" Height="22" CornerRadius="{StaticResource AsaRadiusSm}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6" VerticalAlignment="Center"
                                Visibility="{Binding IsOriginColumnVisible, Source={StaticResource WindowMetrics}, Converter={StaticResource BoolToVisibility}}" />
                        <Border Grid.Column="3" Height="14" CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6" VerticalAlignment="Center" />
                        <Border Grid.Column="4" Height="14" CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Height="56" Padding="12,0">
                    <Grid ColumnSpacing="10" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" MinWidth="220" />
                            <ColumnDefinition Width="{Binding OriginColumnWidth, Source={StaticResource WindowMetrics}}" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <Border Width="18" Height="18" CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6"
                                VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="40" Height="40"
                                CornerRadius="{StaticResource AsaRadiusAvatar}" Background="{ThemeResource AsaSurfaceHoverBrush}"
                                Opacity="0.6" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Height="24" CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6" VerticalAlignment="Center"
                                Margin="8,0,0,0" />
                        <Border Grid.Column="2" Height="22" CornerRadius="{StaticResource AsaRadiusSm}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6" VerticalAlignment="Center"
                                Visibility="{Binding IsOriginColumnVisible, Source={StaticResource WindowMetrics}, Converter={StaticResource BoolToVisibility}}" />
                        <Border Grid.Column="3" Height="14" CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6" VerticalAlignment="Center" />
                        <Border Grid.Column="4" Height="14" CornerRadius="{StaticResource AsaRadiusDefault}"
                                Background="{ThemeResource AsaSurfaceHoverBrush}" Opacity="0.6" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="400"
                Spacing="10"
                Margin="0,0,0,40"
                Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Border
                    Width="54"
                    Height="54"
                    CornerRadius="27"
                    Background="{ThemeResource AsaSurfaceCardBrush}"
                    HorizontalAlignment="Center">
                    <FontIcon
                        Glyph="{x:Bind ViewModel.EmptyGlyph, Mode=OneWay}"
                        FontSize="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource AsaTextTertiaryBrush}" />
                </Border>
                <TextBlock
                    Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}"
                    Style="{StaticResource AsaHeadlineMdTextStyle}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="{x:Bind ViewModel.EmptyDescription, Mode=OneWay}"
                    Style="{StaticResource AsaBodySmTextStyle}"
                    TextAlignment="Center" />
            </StackPanel>

            <!-- F1-5: vazio de FILTRO é distinto do vazio real (mensagem + ação específicas). -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="400"
                Spacing="10"
                Margin="0,0,0,40"
                Visibility="{x:Bind ViewModel.ShowEmptyFiltered, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Border
                    Width="54"
                    Height="54"
                    CornerRadius="27"
                    Background="{ThemeResource AsaSurfaceCardBrush}"
                    HorizontalAlignment="Center">
                    <FontIcon
                        Glyph="{x:Bind ViewModel.EmptyFilteredGlyph, Mode=OneWay}"
                        FontSize="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource AsaTextTertiaryBrush}" />
                </Border>
                <TextBlock
                    Text="{x:Bind ViewModel.EmptyFilteredTitle, Mode=OneWay}"
                    Style="{StaticResource AsaHeadlineMdTextStyle}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="{x:Bind ViewModel.EmptyFilteredDescription, Mode=OneWay}"
                    Style="{StaticResource AsaBodySmTextStyle}"
                    TextAlignment="Center" />
                <Button
                    Content="Limpar filtro"
                    Style="{StaticResource ChipButtonStyle}"
                    HorizontalAlignment="Center"
                    Click="ClearFilter_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
