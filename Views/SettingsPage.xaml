<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Asa.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <Grid Padding="32,24,32,32">
            <StackPanel MaxWidth="780" HorizontalAlignment="Left" Spacing="16">
                <StackPanel Spacing="5" Margin="0,0,0,4">
                    <TextBlock Text="Configurações" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock
                        Text="Ajuste como o Asa se comporta e confira a conexão com o winget."
                        Style="{StaticResource PageSubtitleTextStyle}" />
                </StackPanel>

                <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="5">
                            <TextBlock Text="Instalação silenciosa" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock
                                Text="Instala e atualiza sem abrir janelas do instalador sempre que o pacote oferecer suporte."
                                Style="{StaticResource PageSubtitleTextStyle}" />
                            <TextBlock
                                Text="Alguns instaladores ainda podem pedir permissão do Windows ou exibir uma janela própria."
                                Style="{StaticResource CaptionTextStyle}"
                                TextWrapping="Wrap"
                                Margin="0,4,0,0" />
                        </StackPanel>

                        <ToggleSwitch
                            x:Name="SilentToggle"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            OnContent="Ativada"
                            OffContent="Desativada"
                            Toggled="SilentToggle_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                    <StackPanel Spacing="14">
                        <Grid>
                            <StackPanel Spacing="5">
                                <TextBlock Text="Conexão com o winget" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="O Asa usa a instalação oficial do gerenciador de pacotes do Windows."
                                    Style="{StaticResource PageSubtitleTextStyle}" />
                            </StackPanel>
                            <Button
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Style="{StaticResource ChipButtonStyle}"
                                Click="CheckWinget_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                    <TextBlock Text="Verificar novamente" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="14,11">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Ellipse
                                    x:Name="WingetStatusDot"
                                    Width="9"
                                    Height="9"
                                    Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                    VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock
                                        x:Name="WingetStatusText"
                                        Text="Verificando o winget…"
                                        FontSize="13"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="WingetPathText"
                                        Style="{StaticResource CaptionTextStyle}"
                                        IsTextSelectionEnabled="True"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="PermissionText"
                                        Style="{StaticResource CaptionTextStyle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <InfoBar
                            x:Name="WingetMissingBar"
                            IsOpen="False"
                            IsClosable="False"
                            Severity="Warning"
                            Title="O winget não foi encontrado"
                            Message="Instale o App Installer da Microsoft para que o Asa possa gerenciar seus programas.">
                            <InfoBar.ActionButton>
                                <Button Content="Obter o winget" Click="GetWinget_Click" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="52"
                            Height="52"
                            CornerRadius="14"
                            Background="{ThemeResource AccentFillColorTertiaryBrush}"
                            VerticalAlignment="Top">
                            <TextBlock
                                Text="A"
                                FontSize="24"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="Asa para winget" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="AppVersionText"
                                Text="Versão 1.0"
                                Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock
                                Text="Uma interface leve para descobrir, instalar e atualizar programas no Windows."
                                Style="{StaticResource PageSubtitleTextStyle}"
                                Margin="0,2,0,4" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <HyperlinkButton
                                    Content="Documentação do winget"
                                    NavigateUri="https://learn.microsoft.com/windows/package-manager/winget/"
                                    Padding="0,4"
                                    FontSize="12" />
                                <HyperlinkButton
                                    Content="Abrir pasta de configurações"
                                    Padding="12,4"
                                    FontSize="12"
                                    Click="OpenSettingsFolder_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
