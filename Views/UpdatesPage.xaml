<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Asa.Views.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="Refresh_Invoked" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusFilter_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="32,24,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="5">
                <TextBlock Text="Atualizações" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="{x:Bind ViewModel.HeaderSummary, Mode=OneWay}" Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Spacing="6">
                <ProgressRing
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0" />
                <Button
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Procurar atualizações"
                    AutomationProperties.Name="Procurar atualizações"
                    Click="Refresh_Click">
                    <FontIcon Glyph="&#xE72C;" FontSize="15" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                x:Name="FilterBox"
                Width="300"
                VerticalAlignment="Center"
                PlaceholderText="Filtrar atualizações"
                TextChanged="FilterBox_TextChanged">
                <AutoSuggestBox.QueryIcon>
                    <FontIcon Glyph="&#xE721;" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>

            <Button
                Grid.Column="2"
                IsEnabled="{x:Bind ViewModel.CanUpdateSelected, Mode=OneWay}"
                Style="{StaticResource PrimaryActionButtonStyle}"
                Click="UpdateSelected_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE895;" FontSize="14" />
                    <TextBlock Text="{x:Bind ViewModel.SelectionButtonText, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar
            Grid.Row="2"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            IsClosable="False"
            Severity="Error"
            Title="Não foi possível procurar atualizações"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Margin="0,0,0,10">
            <InfoBar.ActionButton>
                <Button Content="Tentar novamente" Click="Retry_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="3">
            <Border Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,0,0,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,7"
                        Visibility="{x:Bind ViewModel.ShowColumnHeader, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>

                            <CheckBox
                                x:Name="SelectAllBox"
                                Grid.Column="0"
                                IsChecked="{x:Bind ViewModel.AllVisibleSelected, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.HasVisibleUpdates, Mode=OneWay}"
                                Click="SelectAll_Click"
                                ToolTipService.ToolTip="Selecionar todas as atualizações"
                                AutomationProperties.Name="Selecionar todas as atualizações" />

                            <TextBlock
                                Grid.Column="1"
                                Text="PROGRAMA"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="2"
                                Text="VERSÃO"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="3"
                                Text="DISPONÍVEL"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Items}"
                        ItemTemplate="{StaticResource InstalledPackageRowTemplate}"
                        ItemContainerStyle="{StaticResource PackageListItemStyle}"
                        SelectionMode="None"
                        IsItemClickEnabled="False"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Grid>
            </Border>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Margin="0,0,0,40"
                Visibility="{x:Bind ViewModel.IsInitialLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <ProgressRing Width="36" Height="36" IsActive="{x:Bind ViewModel.IsInitialLoading, Mode=OneWay}" />
                <TextBlock
                    Text="Procurando atualizações…"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="400"
                Spacing="10"
                Margin="0,0,0,40"
                Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Border
                    Width="58"
                    Height="58"
                    CornerRadius="29"
                    Background="{ThemeResource AccentFillColorTertiaryBrush}"
                    HorizontalAlignment="Center">
                    <FontIcon
                        Glyph="{x:Bind ViewModel.EmptyGlyph, Mode=OneWay}"
                        FontSize="23"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Border>
                <TextBlock
                    Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}"
                    Style="{StaticResource SectionTitleTextStyle}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="{x:Bind ViewModel.EmptyDescription, Mode=OneWay}"
                    Style="{StaticResource PageSubtitleTextStyle}"
                    TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
